{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clintonmarshall/xteink-flexdisplay-ha/blob/main/docs/release-manifest.schema.json",
  "title": "FlexDisplay coordinated release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_at",
    "platform",
    "android",
    "distribution",
    "packaged_artifacts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "recorded_at": { "type": "string", "format": "date" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "release_tag",
        "release_commit",
        "released_at",
        "classification"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "release_tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+" },
        "release_commit": { "$ref": "#/$defs/gitSha" },
        "released_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "classification": {
          "enum": ["software-only", "firmware-bearing"]
        }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_version", "version_code", "companion_version"],
      "properties": {
        "source_version": { "$ref": "#/$defs/semver" },
        "version_code": { "type": "integer", "minimum": 1 },
        "companion_version": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/distributionState" },
      "required": [
        "forgejo_release",
        "github_compatibility_release",
        "home_assistant_deployment",
        "android_companion",
        "device_firmware_rollout",
        "physical_device_behavior"
      ]
    },
    "packaged_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "distributionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": {
          "enum": ["published", "unpublished", "deployed", "not-deployed", "unverified"]
        },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "config_prefix",
        "version",
        "size",
        "sha256",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "config_prefix": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source_repository",
            "source_revision",
            "recovery_artifact_reference",
            "recovery_artifact_sha256",
            "usb_canary_evidence_reference",
            "unverified_fields"
          ],
          "properties": {
            "status": { "enum": ["verified", "partial"] },
            "source_repository": { "type": "string", "minLength": 1 },
            "source_revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
            "recovery_artifact_reference": { "type": ["string", "null"] },
            "recovery_artifact_sha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "usb_canary_evidence_reference": { "type": ["string", "null"] },
            "unverified_fields": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
